{
  "name": "lucy-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "site:dev": "pnpm --filter @goatsoft/gruff build && pnpm --filter lucy-site dev",
    "site:build": "pnpm --filter @goatsoft/gruff build && pnpm --filter lucy-site build",
    "site:preview": "pnpm --filter lucy-site preview",
    "site:typecheck": "pnpm --filter lucy-site typecheck",
    "icons:typecheck": "pnpm --filter @goatsoft/lucy-icons typecheck",
    "icons:test": "pnpm --filter @goatsoft/lucy-icons test",
    "skills": "node scripts/skills.ts",
    "skills:check": "node scripts/skills.ts --check",
    "changeset": "changeset",
    "release": "pnpm -r --filter \"@goatsoft/lucy-icons\" build && node scripts/publish.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.13"
  }
}
