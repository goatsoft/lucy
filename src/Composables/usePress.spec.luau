return function()
	local Composables = require(script.Parent)
	local Reactive = require(script.Parent.Parent.Core.Reactive)

	describe("usePress", function()
		local frame
		beforeEach(function()
			frame = Instance.new("Frame")
		end)
		afterEach(function()
			frame:Destroy()
		end)

		it("needs an owner", function()
			expect(function()
				Composables.usePress(frame)
			end).to.throw()
		end)

		it("hold: on while pressed, off on release", function()
			local scope = Reactive.effectScope(true)
			scope:run(function()
				local press = Composables.usePress(frame)
				expect(press.active()).to.equal(false)
				press.press()
				expect(press.active()).to.equal(true)
				press.release()
				expect(press.active()).to.equal(false)
			end)
			scope:stop()
		end)

		it("toggle: each press flips it, releases do nothing", function()
			local scope = Reactive.effectScope(true)
			scope:run(function()
				local press = Composables.usePress(frame, { mode = "toggle" })
				press.press()
				press.release()
				expect(press.active()).to.equal(true)
				press.press()
				expect(press.active()).to.equal(false)
			end)
			scope:stop()
		end)

		it("a long press turns on only after it has been held that long", function()
			local scope = Reactive.effectScope(true)
			local press
			scope:run(function()
				press = Composables.usePress(frame, { longPress = 0.1 })
			end)
			press.press()
			expect(press.active()).to.equal(false)
			task.wait(0.2)
			expect(press.active()).to.equal(true)
			press.release()
			expect(press.active()).to.equal(false)
			press.press()
			press.release()
			task.wait(0.2)
			expect(press.active()).to.equal(false)
			scope:stop()
		end)

		it("is writable, so a toggle can be closed from outside", function()
			local scope = Reactive.effectScope(true)
			scope:run(function()
				local press = Composables.usePress(frame, { mode = "toggle" })
				press.press()
				press.active(false)
				expect(press.active()).to.equal(false)
			end)
			scope:stop()
		end)

		it("rejects an unknown mode", function()
			local scope = Reactive.effectScope(true)
			expect(function()
				scope:run(function()
					Composables.usePress(frame, { mode = "tap" })
				end)
			end).to.throw()
			scope:stop()
		end)
	end)
end
