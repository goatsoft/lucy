return function()
	local Composables = require(script.Parent)
	local Reactive = require(script.Parent.Parent.Core.Reactive)
	local Harness = require(script.Parent.Parent.Testing.Harness)

	local app, cleanup
	beforeEach(function()
		app, cleanup = Harness.app()
	end)
	afterEach(function()
		cleanup()
	end)

	describe("useFocus", function()
		it("needs an owner", function()
			expect(function()
				Composables.useFocus(app, Instance.new("Frame"))
			end).to.throw()
		end)

		it("is active while focus is on the target or inside it", function()
			local button = Instance.new("TextButton")
			local inner = Instance.new("TextButton")
			inner.Parent = button
			local other = Instance.new("TextButton")
			local scope = Reactive.effectScope(true)
			scope:run(function()
				local focus = Composables.useFocus(app, button)
				expect(focus.active()).to.equal(false)
				app.input:markFocus(button)
				expect(focus.active()).to.equal(true)
				app.input:markFocus(inner)
				expect(focus.active()).to.equal(true)
				app.input:markFocus(other)
				expect(focus.active()).to.equal(false)
			end)
			app.input:markFocus(nil)
			scope:stop()
			button:Destroy()
			other:Destroy()
		end)
	end)
end
