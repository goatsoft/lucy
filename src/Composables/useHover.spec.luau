return function()
	local Composables = require(script.Parent)
	local Reactive = require(script.Parent.Parent.Core.Reactive)

	describe("useHover", function()
		local frame
		beforeEach(function()
			frame = Instance.new("Frame")
		end)
		afterEach(function()
			frame:Destroy()
		end)

		it("needs an owner", function()
			expect(function()
				Composables.useHover(frame)
			end).to.throw()
		end)

		it("is active from enter to leave with no delays", function()
			local scope = Reactive.effectScope(true)
			scope:run(function()
				local hover = Composables.useHover(frame, { delay = 0, closeDelay = 0 })
				expect(hover.active()).to.equal(false)
				hover.enter()
				expect(hover.active()).to.equal(true)
				hover.leave()
				expect(hover.active()).to.equal(false)
			end)
			scope:stop()
		end)

		it("waits the delay before it turns on, and not at all if the pointer leaves first", function()
			local scope = Reactive.effectScope(true)
			local hover
			scope:run(function()
				hover = Composables.useHover(frame, { delay = 0.1, closeDelay = 0 })
			end)
			hover.enter()
			expect(hover.active()).to.equal(false)
			hover.leave()
			task.wait(0.2)
			expect(hover.active()).to.equal(false)
			hover.enter()
			task.wait(0.2)
			expect(hover.active()).to.equal(true)
			scope:stop()
		end)

		it("stays on when the pointer crosses onto another part before the close delay", function()
			local scope = Reactive.effectScope(true)
			local hover
			scope:run(function()
				hover = Composables.useHover(frame, { delay = 0, closeDelay = 0.1 })
			end)
			hover.enter()
			hover.leave()
			expect(hover.active()).to.equal(true)
			hover.enter()
			task.wait(0.2)
			expect(hover.active()).to.equal(true)
			hover.leave()
			task.wait(0.2)
			expect(hover.active()).to.equal(false)
			scope:stop()
		end)

		it("skips the delay through a delay group while another is open", function()
			local scope = Reactive.effectScope(true)
			local hover
			local group = {
				wait = function()
					return 0
				end,
			}
			scope:run(function()
				hover = Composables.useHover(frame, { delay = 5, closeDelay = 0, group = group })
			end)
			hover.enter()
			expect(hover.active()).to.equal(true)
			scope:stop()
		end)

		it("cancels a pending open when its owner stops", function()
			local scope = Reactive.effectScope(true)
			local hover
			scope:run(function()
				hover = Composables.useHover(frame, { delay = 0.05 })
			end)
			hover.enter()
			scope:stop()
			task.wait(0.1)
			expect(hover.active()).to.equal(false)
		end)
	end)
end
