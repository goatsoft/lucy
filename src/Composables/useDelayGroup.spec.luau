return function()
	local Composables = require(script.Parent)
	local Reactive = require(script.Parent.Parent.Core.Reactive)
	local Harness = require(script.Parent.Parent.Testing.Harness)

	local app, cleanup
	beforeEach(function()
		app, cleanup = Harness.app()
	end)
	afterEach(function()
		cleanup()
	end)

	describe("useDelayGroup", function()
		it("needs an owner", function()
			expect(function()
				Composables.useDelayGroup(app)
			end).to.throw()
		end)

		it("is one group per app", function()
			local scope = Reactive.effectScope(true)
			local a, b
			scope:run(function()
				a = Composables.useDelayGroup(app)
				b = Composables.useDelayGroup(app)
			end)
			expect(a).to.equal(b)
			scope:stop()
		end)

		it("waits the full delay when nothing was open, and none while another is open", function()
			local scope = Reactive.effectScope(true)
			scope:run(function()
				local group = Composables.useDelayGroup(app)
				expect(group.wait(0.5)).to.equal(0.5)
				group.claim("a", function() end)
				expect(group.wait(0.5)).to.equal(0)
			end)
			scope:stop()
		end)

		it("skips the delay for a moment after one closes", function()
			local scope = Reactive.effectScope(true)
			scope:run(function()
				local group = Composables.useDelayGroup(app, { skip = 0.2 })
				group.claim("a", function() end)
				group.release("a")
				expect(group.wait(0.5)).to.equal(0)
				task.wait(0.3)
				expect(group.wait(0.5)).to.equal(0.5)
			end)
			scope:stop()
		end)

		it("closes the one that was open when another claims it", function()
			local scope = Reactive.effectScope(true)
			local closed = {}
			scope:run(function()
				local group = Composables.useDelayGroup(app)
				group.claim("a", function()
					table.insert(closed, "a")
				end)
				group.claim("b", function()
					table.insert(closed, "b")
				end)
				expect(table.concat(closed, ",")).to.equal("a")
				expect(group.current()).to.equal("b")
				group.release("a")
				expect(group.current()).to.equal("b")
				group.release("b")
				expect(group.current()).to.equal(nil)
			end)
			scope:stop()
		end)
	end)
end
