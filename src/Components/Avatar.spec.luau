return function()
	local Avatar = require(script.Parent.Avatar)
	local Reactive = require(script.Parent.Parent.Core.Reactive)
	local Harness = require(script.Parent.Parent.Testing.Harness)

	local app, cleanup, gui
	beforeEach(function()
		app, cleanup = Harness.app({ theme = "light" })
		gui = Harness.mount(app)
	end)
	afterEach(function()
		cleanup()
	end)

	it("makes initials from a name", function()
		expect(Avatar.initials("DJ God")).to.equal("DG")
		expect(Avatar.initials("moonwalker")).to.equal("M")
		expect(Avatar.initials("  lil   nas x ")).to.equal("LN")
		expect(Avatar.initials("")).to.equal("?")
		expect(Avatar.initials(nil)).to.equal("?")
	end)

	it("builds a headshot url for a player", function()
		expect(Avatar.headshot(156)).to.equal("rbxthumb://type=AvatarHeadShot&id=156&w=150&h=150")
		expect(Avatar.headshot(0)).to.equal("")
		expect(Avatar.headshot(-4)).to.equal("")
		expect(Avatar.headshot(nil)).to.equal("")
	end)

	it("shows a player's headshot", function()
		local avatar = Avatar.new({ app = app, Parent = gui, userId = 156, name = "builderman" })
		expect(avatar.image.Image).to.equal("rbxthumb://type=AvatarHeadShot&id=156&w=150&h=150")
		expect(avatar.image.Visible).to.equal(true)
		expect(avatar.monogram.Visible).to.equal(false)
	end)

	it("shows a monogram for a bot or no player", function()
		local userId = Reactive.ref(-3)
		local avatar = Avatar.new({ app = app, Parent = gui, userId = userId, name = "DJ God" })
		expect(avatar.image.Visible).to.equal(false)
		expect(avatar.monogram.Visible).to.equal(true)
		expect(avatar.monogram.Text).to.equal("DG")
		userId(156)
		expect(avatar.image.Visible).to.equal(true)
		expect(avatar.monogram.Visible).to.equal(false)
		avatar:set("userId", 0)
		avatar:set("name", "Robo")
		expect(avatar.monogram.Visible).to.equal(true)
		expect(avatar.monogram.Text).to.equal("R")
	end)

	it("comes in three sizes", function()
		local avatar = Avatar.new({ app = app, Parent = gui, name = "A", size = "sm" })
		expect(avatar.Instance.Size).to.equal(UDim2.fromOffset(Avatar.sizes.sm, Avatar.sizes.sm))
		avatar:set("size", "lg")
		expect(avatar.Instance.Size).to.equal(UDim2.fromOffset(Avatar.sizes.lg, Avatar.sizes.lg))
		expect(avatar.Instance:HasTag("ui-avatar-size-lg")).to.equal(true)
		expect(function()
			Avatar.new({ app = app, Parent = gui, size = "xl" })
		end).to.throw()
	end)

	it("is round unless asked to be square", function()
		local round = Avatar.new({ app = app, Parent = gui, name = "A" })
		expect(round.Instance:HasTag("ui-avatar-square")).to.equal(false)
		local square = Avatar.new({ app = app, Parent = gui, name = "A", square = true })
		expect(square.Instance:HasTag("ui-avatar-square")).to.equal(true)
	end)
end
