return function()
	local Kbd = require(script.Parent.Kbd)
	local Reactive = require(script.Parent.Parent.Core.Reactive)
	local Harness = require(script.Parent.Parent.Testing.Harness)

	local app, cleanup, gui
	beforeEach(function()
		app, cleanup = Harness.app({ theme = "light" })
		gui = Harness.mount(app)
	end)
	afterEach(function()
		cleanup()
	end)

	it("names keys in plain text", function()
		expect(Kbd.label(Enum.KeyCode.E)).to.equal("E")
		expect(Kbd.label(Enum.KeyCode.Escape)).to.equal("Esc")
		expect(Kbd.label(Enum.KeyCode.Return)).to.equal("Enter")
		expect(Kbd.label(Enum.KeyCode.LeftShift)).to.equal("Shift")
		expect(Kbd.label(Enum.KeyCode.ButtonL1)).to.equal("LB")
		expect(Kbd.label(Enum.KeyCode.DPadUp)).to.equal("D-Pad Up")
		expect(Kbd.label("Hold")).to.equal("Hold")
		expect(Kbd.label(nil)).to.equal("")
		expect(Kbd.label("")).to.equal("")
	end)

	it("finds the controller's own picture for a gamepad button", function()
		expect(Kbd.glyph(Enum.KeyCode.ButtonA) ~= "").to.equal(true)
		expect(Kbd.glyph("A")).to.equal("")
		expect(Kbd.glyph(nil)).to.equal("")
	end)

	it("shows the key for the input the player is using", function()
		local kbd = Kbd.new({
			app = app,
			Parent = gui,
			keyboard = Enum.KeyCode.E,
			gamepad = Enum.KeyCode.ButtonY,
		})
		app.input:setMode("keyboard")
		expect(kbd.Instance.Visible).to.equal(true)
		expect(kbd.text.Visible).to.equal(true)
		expect(kbd.text.Text).to.equal("E")
		expect(kbd.glyph.Visible).to.equal(false)
		app.input:setMode("mouse")
		expect(kbd.text.Text).to.equal("E")
		app.input:setMode("gamepad")
		expect(kbd.glyph.Visible).to.equal(true)
		expect(kbd.glyph.Image).to.equal(Kbd.glyph(Enum.KeyCode.ButtonY))
		expect(kbd.text.Visible).to.equal(false)
		expect(kbd.Instance:HasTag("ui-kbd-glyph")).to.equal(true)
	end)

	it("hides itself on touch unless given a touch label", function()
		local kbd = Kbd.new({ app = app, Parent = gui, keyboard = Enum.KeyCode.E })
		app.input:setMode("touch")
		expect(kbd.Instance.Visible).to.equal(false)
		local hold = Kbd.new({ app = app, Parent = gui, keyboard = Enum.KeyCode.E, touch = "Hold" })
		expect(hold.Instance.Visible).to.equal(true)
		expect(hold.text.Text).to.equal("Hold")
	end)

	it("hides itself when there is no key for the input", function()
		local kbd = Kbd.new({ app = app, Parent = gui, keyboard = Enum.KeyCode.E })
		app.input:setMode("gamepad")
		expect(kbd.Instance.Visible).to.equal(false)
		app.input:setMode("keyboard")
		expect(kbd.Instance.Visible).to.equal(true)
	end)

	it("shows a gamepad key as text when it has no picture", function()
		local kbd = Kbd.new({ app = app, Parent = gui, gamepad = "Hold A" })
		app.input:setMode("gamepad")
		expect(kbd.text.Visible).to.equal(true)
		expect(kbd.text.Text).to.equal("Hold A")
		expect(kbd.glyph.Visible).to.equal(false)
	end)

	it("follows reactive keys and visible", function()
		local key = Reactive.ref(Enum.KeyCode.E)
		local visible = Reactive.ref(true)
		app.input:setMode("keyboard")
		local kbd = Kbd.new({ app = app, Parent = gui, keyboard = key, visible = visible })
		key(Enum.KeyCode.Q)
		expect(kbd.text.Text).to.equal("Q")
		visible(false)
		expect(kbd.Instance.Visible).to.equal(false)
	end)

	it("names the face of a gamepad button for its controller", function()
		expect(Kbd.face(Enum.KeyCode.ButtonA, "xbox")).to.equal("xbox-a")
		expect(Kbd.face(Enum.KeyCode.ButtonY, "xbox")).to.equal("xbox-y")
		expect(Kbd.face(Enum.KeyCode.ButtonA, "playstation")).to.equal("playstation-cross")
		expect(Kbd.face(Enum.KeyCode.ButtonX, "playstation")).to.equal("playstation-square")
		expect(Kbd.face(Enum.KeyCode.ButtonL1, "xbox")).to.equal(nil)
		expect(Kbd.face("A", "xbox")).to.equal(nil)
		expect(Kbd.platform() == "xbox" or Kbd.platform() == "playstation").to.equal(true)
	end)

	it("colours the face buttons by default", function()
		app.input:setMode("gamepad")
		local kbd = Kbd.new({ app = app, Parent = gui, gamepad = Enum.KeyCode.ButtonA })
		local face = "ui-kbd-face-" .. (Kbd.face(Enum.KeyCode.ButtonA, Kbd.platform()) :: string)
		expect(kbd.glyph:HasTag(face)).to.equal(true)
		kbd:set("variant", "mono")
		expect(kbd.glyph:HasTag(face)).to.equal(false)
		local bumper = Kbd.new({ app = app, Parent = gui, gamepad = Enum.KeyCode.ButtonR1 })
		for _, tag in bumper.glyph:GetTags() do
			local found = string.find(tag, "ui-kbd-face-", 1, true)
			expect(found).to.equal(nil)
		end
		expect(function()
			Kbd.new({ app = app, Parent = gui, variant = "neon" })
		end).to.throw()
	end)

	it("uses the controller colour for a face button", function()
		app.input:setMode("gamepad")
		local kbd = Kbd.new({ app = app, Parent = gui, gamepad = Enum.KeyCode.ButtonB })
		Harness.flush()
		local token = Kbd.faceColours[Kbd.face(Enum.KeyCode.ButtonB, Kbd.platform()) :: string]
		expect(
			Harness.colorEq(Harness.styled(kbd.glyph, "ImageColor3"), app.theme:resolve(string.sub(token, 2)))
		).to.equal(true)
	end)

	it("shows an action's keys and follows a rebind", function()
		app.actions:define("specKbd", { specDance = { Enum.KeyCode.E, Enum.KeyCode.ButtonX } })
		local kbd = Kbd.new({ app = app, Parent = gui, action = "specDance" })
		app.input:setMode("keyboard")
		expect(kbd.text.Text).to.equal("E")
		app.input:setMode("gamepad")
		expect(kbd.glyph.Visible).to.equal(true)
		expect(kbd.glyph.Image).to.equal(Kbd.glyph(Enum.KeyCode.ButtonX))
		app.input:setMode("keyboard")
		app.actions:bind("specDance", { Enum.KeyCode.F, Enum.KeyCode.ButtonY })
		expect(kbd.text.Text).to.equal("F")
		app.input:setMode("touch")
		expect(kbd.Instance.Visible).to.equal(false)
	end)

	it("hides an action's key cap when the action has no key for the input", function()
		app.actions:define("specKbd", { specEmote = { Enum.KeyCode.G } })
		local kbd = Kbd.new({ app = app, Parent = gui, action = "specEmote" })
		app.input:setMode("gamepad")
		expect(kbd.Instance.Visible).to.equal(false)
		app.input:setMode("keyboard")
		expect(kbd.Instance.Visible).to.equal(true)
		expect(kbd.text.Text).to.equal("G")
	end)
end
