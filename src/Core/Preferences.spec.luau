return function()
	local Reactive = require(script.Parent.Reactive)
	local Preferences = require(script.Parent.Preferences)

	afterEach(function()
		Preferences.setReducedMotion(nil)
		Preferences._setDevice({})
	end)

	describe("reducedMotion", function()
		it("follows the Roblox setting", function()
			Preferences._setDevice({ reducedMotion = true })
			expect(Preferences.reducedMotion()).to.equal(true)
			Preferences._setDevice({ reducedMotion = false })
			expect(Preferences.reducedMotion()).to.equal(false)
		end)

		it("can be set by the game, and nil follows Roblox again", function()
			Preferences._setDevice({ reducedMotion = false })
			Preferences.setReducedMotion(true)
			expect(Preferences.reducedMotion()).to.equal(true)
			Preferences.setReducedMotion(nil)
			expect(Preferences.reducedMotion()).to.equal(false)
		end)

		it("is tracked", function()
			local seen = {}
			local scope = Reactive.effectScope(true)
			scope:run(function()
				Reactive.watchEffect(function()
					table.insert(seen, Preferences.reducedMotion())
				end)
			end)
			Preferences.setReducedMotion(true)
			scope:stop()
			expect(seen[#seen]).to.equal(true)
			expect(#seen >= 2).to.equal(true)
		end)
	end)

	describe("textSize", function()
		it("follows the Roblox setting by name", function()
			Preferences._setDevice({ textSize = "Larger" })
			expect(Preferences.textSize()).to.equal("Larger")
		end)

		it("is Medium by default", function()
			Preferences._setDevice({ textSize = "Medium" })
			expect(Preferences.textSize()).to.equal("Medium")
		end)
	end)

	describe("added", function()
		it("is how much taller Roblox draws text of a size, never less than 0", function()
			local added = Preferences.added(14)
			expect(type(added)).to.equal("number")
			expect(added >= 0).to.equal(true)
		end)
	end)
end
