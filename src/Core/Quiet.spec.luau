return function()
	local Reactive = require(script.Parent.Reactive)
	local Harness = require(script.Parent.Parent.Testing.Harness)

	local app, cleanup
	beforeEach(function()
		app, cleanup = Harness.app()
	end)
	afterEach(function()
		cleanup()
	end)

	describe("push and release", function()
		it("is not quiet until a reason is pushed", function()
			expect(app.quiet:active()).to.equal(false)
			expect(app.quiet:allows("rewards")).to.equal(true)
		end)

		it("goes quiet while a reason is pushed and publishes it", function()
			local release = app.quiet:push("tour")
			expect(app.quiet:active()).to.equal(true)
			local reasons = app.state:get("quiet.reasons")
			expect(#reasons).to.equal(1)
			expect(reasons[1].reason).to.equal("tour")
			release()
			expect(app.quiet:active()).to.equal(false)
			expect(#app.state:get("quiet.reasons")).to.equal(0)
		end)

		it("counts each push, the same reason included", function()
			local first = app.quiet:push("tour")
			local second = app.quiet:push("tour")
			first()
			expect(app.quiet:active()).to.equal(true)
			second()
			expect(app.quiet:active()).to.equal(false)
		end)

		it("releases once however often release is called", function()
			local first = app.quiet:push("a")
			local second = app.quiet:push("b")
			first()
			first()
			expect(app.quiet:active()).to.equal(true)
			second()
			expect(app.quiet:active()).to.equal(false)
		end)

		it("releases with the owner that pushed it", function()
			local scope = Reactive.effectScope(true)
			scope:run(function()
				app.quiet:push("cutscene")
			end)
			expect(app.quiet:active()).to.equal(true)
			scope:stop()
			expect(app.quiet:active()).to.equal(false)
		end)

		it("rejects a reason that is not a string", function()
			expect(function()
				app.quiet:push(nil :: any)
			end).to.throw()
		end)
	end)

	describe("channels", function()
		it("blocks every channel but those the reason allows", function()
			app.quiet:push("tour", { allow = { "tour" } })
			expect(app.quiet:allows("tour")).to.equal(true)
			expect(app.quiet:allows("rewards")).to.equal(false)
			expect(app.quiet:allows("default")).to.equal(false)
		end)

		it("needs every reason to allow a channel", function()
			app.quiet:push("tour", { allow = { "tour", "rewards" } })
			app.quiet:push("cutscene", { allow = { "rewards" } })
			expect(app.quiet:allows("rewards")).to.equal(true)
			expect(app.quiet:allows("tour")).to.equal(false)
		end)

		it("always allows essential", function()
			app.quiet:push("tour")
			expect(app.quiet:allows("essential")).to.equal(true)
		end)

		it("is tracked", function()
			local seen = {}
			local stop = Reactive.watchEffect(function()
				table.insert(seen, app.quiet:allows("rewards"))
			end)
			local release = app.quiet:push("tour")
			release()
			stop()
			expect(#seen).to.equal(3)
			expect(seen[1]).to.equal(true)
			expect(seen[2]).to.equal(false)
			expect(seen[3]).to.equal(true)
		end)
	end)

	describe("after", function()
		it("runs at once when the channel is allowed", function()
			local runs = 0
			app.quiet:after("rewards", function()
				runs += 1
			end)
			expect(runs).to.equal(1)
		end)

		it("waits until the channel is allowed, then runs once", function()
			local release = app.quiet:push("tour")
			local runs = 0
			app.quiet:after("rewards", function()
				runs += 1
			end)
			expect(runs).to.equal(0)
			release()
			expect(runs).to.equal(1)
			app.quiet:push("again")()
			expect(runs).to.equal(1)
		end)

		it("keeps waiting while another reason still blocks", function()
			local first = app.quiet:push("tour")
			local second = app.quiet:push("cutscene")
			local runs = 0
			app.quiet:after("rewards", function()
				runs += 1
			end)
			first()
			expect(runs).to.equal(0)
			second()
			expect(runs).to.equal(1)
		end)

		it("can be cancelled", function()
			local release = app.quiet:push("tour")
			local runs = 0
			local cancel = app.quiet:after("rewards", function()
				runs += 1
			end)
			cancel()
			release()
			expect(runs).to.equal(0)
		end)
	end)
end
