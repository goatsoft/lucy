return function()
	local Reactive = require(script.Parent.Reactive)
	local Animate = require(script.Parent.Animate)
	local ref = Reactive.ref

	local scope
	beforeEach(function()
		Animate.manual = true
		scope = Reactive.effectScope(true)
	end)
	afterEach(function()
		scope:stop()
		Animate.manual = false
	end)

	local function run(fn)
		return scope:run(fn)
	end

	local function settle(seconds: number)
		for _ = 1, math.ceil(seconds * 60) do
			Animate.step(1 / 60)
		end
	end

	describe("spring", function()
		it("starts at the source value and moves toward a new target", function()
			local target = ref(0)
			local value = run(function()
				return Animate.spring(target, 4, 1)
			end)
			expect(value()).to.equal(0)
			target(100)
			expect(value()).to.equal(0) -- nothing moves until a frame passes
			Animate.step(1 / 60)
			local early = value()
			expect(early > 0 and early < 100).to.equal(true)
			settle(3)
			expect(value()).to.equal(100)
		end)

		it("animates UDim2 and Color3 (in Oklab)", function()
			local size = ref(UDim2.fromOffset(0, 0))
			local color = ref(Color3.new(0, 0, 0))
			local s, c = run(function()
				return Animate.spring(size, 6), Animate.spring(color, 6)
			end)
			size(UDim2.new(1, 20, 0, 40))
			color(Color3.new(1, 1, 1))
			settle(3)
			expect(s()).to.equal(UDim2.new(1, 20, 0, 40))
			local final = c()
			expect(math.abs(final.R - 1) < 1e-3 and math.abs(final.B - 1) < 1e-3).to.equal(true)
		end)

		it("snaps when the value type changes or cannot be animated", function()
			local value = ref(1 :: any)
			local out = run(function()
				return Animate.spring(value)
			end)
			value("text")
			expect(out()).to.equal("text")
		end)

		it("drives bindings like any other source", function()
			local target = ref(0)
			local seen
			run(function()
				local value = Animate.spring(target, 8)
				Reactive.watchEffect(function()
					seen = value()
				end)
			end)
			target(10)
			settle(2)
			expect(seen).to.equal(10)
		end)
	end)

	describe("tween", function()
		it("follows the TweenInfo curve and lands exactly on the target", function()
			local target = ref(0)
			local value = run(function()
				return Animate.tween(target, TweenInfo.new(1, Enum.EasingStyle.Linear))
			end)
			target(10)
			settle(0.5)
			expect(math.abs(value() - 5) < 0.2).to.equal(true)
			settle(0.6)
			expect(value()).to.equal(10)
		end)

		it("retargets from where it is", function()
			local target = ref(0)
			local value = run(function()
				return Animate.tween(target, TweenInfo.new(1, Enum.EasingStyle.Linear))
			end)
			target(10)
			settle(0.5)
			target(0)
			Animate.step(1 / 60)
			expect(value() > 4 and value() < 6).to.equal(true)
		end)

		it("jumps at once when the TweenInfo takes no time, even mid tween", function()
			local target = ref(0)
			local slow = TweenInfo.new(1, Enum.EasingStyle.Linear)
			local info = ref(slow)
			local value = run(function()
				return Animate.tween(target, info)
			end)
			target(10)
			settle(0.5)
			info(TweenInfo.new(0))
			target(20)
			expect(value()).to.equal(20)
			Animate.step(1 / 60)
			expect(value()).to.equal(20)
			info(slow)
			target(0)
			Animate.step(1 / 60)
			expect(value() > 19 and value() < 20).to.equal(true)
		end)
	end)

	describe("reduced motion", function()
		local Preferences = require(script.Parent.Preferences)
		afterEach(function()
			Preferences.setReducedMotion(nil)
		end)

		it("springs jump to their target", function()
			Preferences.setReducedMotion(true)
			local target = ref(0)
			local value = run(function()
				return Animate.spring(target, 4, 1)
			end)
			target(100)
			expect(value()).to.equal(100)
		end)

		it("tweens of positions and sizes jump", function()
			Preferences.setReducedMotion(true)
			local target = ref(UDim2.fromOffset(0, 0))
			local value = run(function()
				return Animate.tween(target, TweenInfo.new(1))
			end)
			target(UDim2.fromOffset(100, 50))
			expect(value()).to.equal(UDim2.fromOffset(100, 50))
		end)

		it("tweens of colours and numbers still fade", function()
			Preferences.setReducedMotion(true)
			local color = ref(Color3.new(0, 0, 0))
			local alpha = ref(0)
			local c, a = run(function()
				return Animate.tween(color, TweenInfo.new(1, Enum.EasingStyle.Linear)),
					Animate.tween(alpha, TweenInfo.new(1, Enum.EasingStyle.Linear))
			end)
			color(Color3.new(1, 1, 1))
			alpha(1)
			settle(0.5)
			expect(c().R > 0.1 and c().R < 0.9).to.equal(true)
			expect(a() > 0.4 and a() < 0.6).to.equal(true)
			settle(0.6)
			expect(a()).to.equal(1)
		end)

		it("stops a move already running when it is turned on", function()
			local target = ref(UDim2.fromOffset(0, 0))
			local value = run(function()
				return Animate.tween(target, TweenInfo.new(1))
			end)
			target(UDim2.fromOffset(100, 0))
			settle(0.2)
			Preferences.setReducedMotion(true)
			target(UDim2.fromOffset(40, 0))
			expect(value()).to.equal(UDim2.fromOffset(40, 0))
		end)
	end)
end
