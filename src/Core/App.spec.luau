return function()
	local Harness = require(script.Parent.Parent.Testing.Harness)

	local app, cleanup
	beforeEach(function()
		app, cleanup = Harness.app({ theme = "light" })
	end)
	afterEach(function()
		cleanup()
	end)

	it("wires state, theme and scenes", function()
		expect(app.state).to.be.ok()
		expect(app.theme).to.be.ok()
		expect(app.scenes).to.be.ok()
		expect(app.theme:get()).to.equal("light")
		expect(app.state:get("theme")).to.equal("light")
	end)

	it("counts pushed modal scenes as modal, not overlays", function()
		app.scenes:register("Pause", { layer = "modal" })
		app.scenes:register("Hud", { layer = "overlay" })
		expect(app:modalOpen()).to.equal(false)
		app.scenes:push("Hud")
		expect(app:modalOpen()).to.equal(false)
		app.scenes:push("Pause")
		expect(app:modalOpen()).to.equal(true)
		app.scenes:pop()
		expect(app:modalOpen()).to.equal(false)
	end)

	it("gives the current app to other scripts with App.current", function()
		local App = require(script.Parent.App)
		local Context = require(script.Parent.Context)
		local previous = Context.getCurrent()
		local made = App.new({
			namePrefix = "CurrentTest_",
			parent = Harness.guiParent(),
			input = { watch = false, caps = Harness.caps.desktop },
		})
		-- Destroyed and put back before any expect, so a failure leaks nothing.
		local ok, seen = pcall(App.current)
		made:destroy()
		local after = App.current and App.current()
		Context.setCurrent(previous)
		expect(ok).to.equal(true)
		expect(seen).to.equal(made)
		expect(after).to.equal(nil)
	end)

	it("switches theme from app state", function()
		app.state:set("theme", "dark")
		expect(app.theme:get()).to.equal("dark")
	end)

	it("mirrors setTheme into app state", function()
		app:setTheme("dark")
		expect(app.state:get("theme")).to.equal("dark")
	end)

	it("reverts app state when asked for an unknown theme", function()
		app.state:set("theme", "sepia")
		expect(app.theme:get()).to.equal("light")
		expect(app.state:get("theme")).to.equal("light")
	end)

	it("creates linked, cached portal guis", function()
		local gui = app:portal("modal")
		expect(gui:IsA("ScreenGui")).to.equal(true)
		expect(gui:FindFirstChildOfClass("StyleLink").StyleSheet).to.equal(app.theme.design)
		expect(app:portal("modal")).to.equal(gui)
		expect(gui.ResetOnSpawn).to.equal(false)
		expect(app:portal("toast").DisplayOrder > gui.DisplayOrder).to.equal(true)
	end)

	it("builds themes from a base colour and primary hue", function()
		local tinted, done = Harness.app({ baseColor = "slate", primary = "violet", theme = "light" })
		expect(tinted.theme:resolve("Primary")).to.equal(tinted.theme:resolve("Violet600"))
		expect(tinted.theme:resolve("Border")).to.equal(tinted.theme:resolve("Slate200"))
		done()
	end)

	it("publishes input state and follows the device with density", function()
		expect(app.state:get("input.device")).to.equal("desktop")
		expect(app.theme:getDensity()).to.equal("default")
		app.input:setCaps(Harness.caps.mobile)
		expect(app.theme:getDensity()).to.equal("touch")
		app.input:setCaps(Harness.caps.console)
		expect(app.theme:getDensity()).to.equal("tv")
	end)

	it("keeps a pinned density whatever the device", function()
		local pinned, done = Harness.app({ density = "touch" })
		pinned.input:setCaps(Harness.caps.console)
		expect(pinned.theme:getDensity()).to.equal("touch")
		done()
	end)

	it("switches the adaptive profile with the device", function()
		local gui = app:portal("modal")
		local scale = gui:FindFirstChild("LucyScale")
		expect(scale).to.be.ok()
		app.input:setCaps(Harness.caps.console)
		expect(scale.Scale >= 1).to.equal(true)
	end)

	it("lists enabled guis topmost first", function()
		local modal = app:portal("modal")
		local toast = app:portal("toast")
		local guis = app:activeGuis()
		expect(guis[1]).to.equal(toast)
		expect(table.find(guis, modal)).to.be.ok()
		modal.Enabled = false
		expect(table.find(app:activeGuis(), modal)).to.equal(nil)
	end)

	it("hands out sequential ids per kind", function()
		expect(app:nextId("button")).to.equal("button-1")
		expect(app:nextId("button")).to.equal("button-2")
		expect(app:nextId("badge")).to.equal("badge-1")
	end)

	it("removes everything it made on destroy", function()
		local gui = app:portal("modal")
		local folder = app.theme.folder
		cleanup()
		expect(gui.Parent).to.equal(nil)
		expect(folder.Parent).to.equal(nil)
		-- Re-create so afterEach has something to clean.
		app, cleanup = Harness.app()
	end)
end
