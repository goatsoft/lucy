return function()
	local Check = require(script.Parent.Check)

	it("passes good values and names what is wrong with bad ones", function()
		expect((Check.boolean(true))).to.equal(true)
		local ok, why = Check.boolean("yes")
		expect(ok).to.equal(false)
		expect(type(why)).to.equal("string")
		expect((Check.any(1))).to.equal(true)
		expect((Check.any(nil))).to.equal(false)
	end)

	it("limits strings by length, 200 bytes when not told", function()
		local short = Check.string({ min = 1, max = 4 })
		expect((short("abc"))).to.equal(true)
		expect((short(""))).to.equal(false)
		expect((short("abcde"))).to.equal(false)
		expect((Check.string()(string.rep("a", 201)))).to.equal(false)
	end)

	it("refuses NaN, infinity and numbers out of range", function()
		local n = Check.number({ min = 0, max = 10, integer = true })
		expect((n(5))).to.equal(true)
		expect((n(0 / 0))).to.equal(false)
		expect((n(math.huge))).to.equal(false)
		expect((n(11))).to.equal(false)
		expect((n(2.5))).to.equal(false)
	end)

	it("limits a vector's length and refuses NaN", function()
		local v = Check.vector({ max = 10 })
		expect((v(Vector3.new(1, 2, 3)))).to.equal(true)
		expect((v(Vector3.new(100, 0, 0)))).to.equal(false)
		expect((v(Vector3.new(0 / 0, 0, 0)))).to.equal(false)
		expect((v({ X = 1 }))).to.equal(false)
	end)

	it("checks lists, maps, structs, choices and optional values", function()
		local list = Check.array(Check.number(), 3)
		expect((list({ 1, 2 }))).to.equal(true)
		expect((list({ 1, 2, 3, 4 }))).to.equal(false)
		expect((list({ 1, "x" }))).to.equal(false)
		expect((list({ [1] = 1, [3] = 3 }))).to.equal(false)
		expect((list(setmetatable({}, {})))).to.equal(false)

		local map = Check.map(Check.string(), Check.boolean, 2)
		expect((map({ a = true }))).to.equal(true)
		expect((map({ a = true, b = true, c = true }))).to.equal(false)

		local shape = Check.struct({ id = Check.string(), count = Check.optional(Check.number()) })
		expect((shape({ id = "a" }))).to.equal(true)
		expect((shape({ id = "a", extra = 1 }))).to.equal(false)
		expect((shape({ count = 1 }))).to.equal(false)

		local pick = Check.oneOf({ "red", "blue" })
		expect((pick("red"))).to.equal(true)
		expect((pick("green"))).to.equal(false)
	end)

	it("checks a call's arguments and refuses extra ones", function()
		local args = Check.args({ Check.string(), Check.optional(Check.number()) })
		expect((args("a"))).to.equal(true)
		expect((args("a", 1))).to.equal(true)
		expect((args("a", nil, nil))).to.equal(true)
		expect((args("a", 1, "extra"))).to.equal(false)
		local ok, why = args(1)
		expect(ok).to.equal(false)
		expect(string.find(why :: string, "argument 1", 1, true) ~= nil).to.equal(true)
	end)
end
