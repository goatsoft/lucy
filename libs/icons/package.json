{
  "name": "@goatsoft/lucy-icons",
  "version": "0.1.0",
  "description": "Packs the Iconify icons a Roblox game uses into uploaded sprite sheets for Lucy's Icon component.",
  "keywords": [
    "roblox",
    "luau",
    "icons",
    "iconify",
    "sprite-sheet",
    "lucy"
  ],
  "license": "MIT",
  "homepage": "https://lucy.goatsoft.io/docs/guide/icons",
  "bugs": {
    "url": "https://github.com/goatsoft/lucy/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goatsoft/lucy.git",
    "directory": "libs/icons"
  },
  "type": "module",
  "bin": {
    "lucy-icons": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"src/**/*.test.ts\"",
    "icons": "node src/cli.ts",
    "prepack": "node ../../scripts/prepack.ts"
  },
  "dependencies": {
    "@iconify/types": "^2.0.0",
    "@iconify/utils": "^3.1.7",
    "@resvg/resvg-js": "^2.6.2"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.149",
    "@types/node": "^24.19.2",
    "typescript": "~5.9.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  }
}
