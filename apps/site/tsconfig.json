{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "paths": { "@/*": ["./src/*"], "~/*": ["../../*"] },
    "composite": false,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "types": ["node", "vite/client", "unplugin-icons/types/vue", "@goatsoft/gruff/client"],
    "allowImportingTsExtensions": true
  },
  "include": ["src", "src/**/*.vue", "vite.config.ts", "prerender.ts"]
}
