{
  "name": "LucyTests",
  "servePort": 38574,
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Lucy": {
        "$path": "src"
      },
      "DevPackages": {
        "$path": "DevPackages"
      },
      "LucyTests": {
        "$path": "tests"
      },
      "LucyExamples": {
        "$path": "examples"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "LucyShowcase": {
          "$path": "examples/Showcase.client.luau"
        }
      }
    },
    "ServerScriptService": {
      "RunTests": {
        "$path": "scripts/run-tests.server.luau"
      }
    }
  }
}
